// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserActionType {
  LOCK
  UNLOCK
  ENABLE
  DISABLE
  ADD_AUTHORITY
  REMOVE_AUTHORITY
}

enum Authority {
  COMMON //Usuário comum
  EDITOR //Pode criar e editar artigos
  HELPER //Pode publicar e desativar artigos, criar e editar stacks
  MODERATOR //Pode atribuir (ou remover) editores e helpers e pode desativar usuários
  ADMIN //Pode criar moderadores, criar usuários
  ROOT //Pode atribuir admins
}

model UserAction {
  id         Int            @id @default(autoincrement())
  actionById Int
  targetId   Int
  reason     String?
  details    String?
  action     UserActionType
  createdAt  DateTime       @default(now())
}

model User {
  id             Int         @id @default(autoincrement())
  uid            String      @unique @default(cuid())
  email          String      @unique @db.VarChar(150)
  name           String      @db.VarChar(55)
  username       String      @unique @db.VarChar(55)
  avatarURL      String?
  avatarFilePath String?
  bio            String?
  password       String
  enabled        Boolean     @default(true)
  locked         Boolean     @default(false)
  emailVerified  Boolean     @default(false)
  social         Social[]
  authorities    Authority[]
  joinedAt       DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  Article        Article[]
}

model Social {
  id         Int     @id @default(autoincrement())
  identifier String  @unique @db.VarChar(50)
  url        String
  details    String? @db.VarChar(30)
  user       User    @relation(fields: [userId], references: [id])
  userId     Int
}

model Stack {
  id               Int       @id @default(autoincrement())
  name             String    @unique @db.VarChar(55)
  slug             String    @unique @db.VarChar(100)
  description      String
  metaDescription  String    @db.VarChar(220)
  enabled          Boolean   @default(true)
  createdByUserUid String
  createdAt        DateTime  @default(now())
  Article          Article[]
}

model ActionOnStack {
  id            Int               @id @default(autoincrement())
  actionByIud   Int
  targetStackId Int
  reason        String?
  details       String?
  action        ActionOnStackType
  createdAt     DateTime          @default(now())
}

enum ActionOnStackType {
  ENABLE
  DISABLE
  EDIT
}

enum ActionOnArticleType {
  PUBLISH
  UNPUBLISH
  ENABLE
  DISABLE
}

model ArticleAction {
  id             Int                 @id @default(autoincrement())
  articleId      Int
  actionByUserId Int
  actionType     ActionOnArticleType
  reason         String?
  details        String?

  createdAt DateTime @default(now())
}

model Article {
  id              Int      @id @default(autoincrement())
  uid             String   @unique @default(cuid())
  title           String   @unique @db.VarChar(250)
  slug            String   @unique
  content         String   @db.Text
  description     String
  metaDescription String   @db.VarChar(220)
  stack           Stack    @relation(fields: [stackId], references: [id])
  stackId         Int
  enabled         Boolean  @default(true)
  isPublished     Boolean  @default(false)
  createdBy       User     @relation(fields: [creatorId], references: [id])
  creatorId       Int
  accessCount     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}
